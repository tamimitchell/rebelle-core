{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rebelle:a2ui:story:1",
  "catalogId": "urn:rebelle:a2ui:story:1",
  "title": "Rebelle story",
  "description": "Bounded A2UI v0.9.1 catalog: one root Story bound to /storyView, a read-only view of a story document and where it stands. No functions, actions or other components; the story is drawn by the shared renderer, and authored HTML is literal. Markdown heading and link rules are additionally checked by the shared prose parser.",
  "components": {
    "Story": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "const": "root"
        },
        "component": {
          "type": "string",
          "const": "Story"
        },
        "view": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "const": "/storyView"
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "component",
        "view"
      ],
      "additionalProperties": false
    }
  },
  "functions": [],
  "$defs": {
    "anyComponent": {
      "$ref": "#/components/Story"
    },
    "theme": {
      "type": "object",
      "additionalProperties": false
    },
    "anyFunction": false,
    "StoryViewData": {
      "type": "object",
      "properties": {
        "story": {
          "type": "object",
          "properties": {
            "headline": {
              "type": "string",
              "maxLength": 200,
              "pattern": "\\S"
            },
            "summary": {
              "type": "string",
              "maxLength": 600,
              "pattern": "\\S"
            },
            "as_of": {
              "type": "string",
              "format": "date-time"
            },
            "telling": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "component": {
                        "type": "string",
                        "const": "Paragraph"
                      },
                      "content": {
                        "type": "object",
                        "properties": {
                          "text": {
                            "type": "string",
                            "maxLength": 2000,
                            "pattern": "\\S"
                          }
                        },
                        "required": [
                          "text"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "component",
                      "content"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "component": {
                        "type": "string",
                        "const": "Standings"
                      },
                      "content": {
                        "type": "object",
                        "properties": {
                          "caption": {
                            "type": "string",
                            "maxLength": 200,
                            "pattern": "\\S"
                          },
                          "rows": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "position": {
                                  "type": "integer",
                                  "minimum": 1,
                                  "maximum": 999
                                },
                                "team_number": {
                                  "type": "string",
                                  "pattern": "^\\d{1,4}$"
                                },
                                "name": {
                                  "type": "string",
                                  "maxLength": 120,
                                  "pattern": "\\S"
                                },
                                "crew": {
                                  "type": "string",
                                  "maxLength": 120,
                                  "pattern": "\\S"
                                },
                                "vehicle": {
                                  "type": "string",
                                  "maxLength": 120,
                                  "pattern": "\\S"
                                },
                                "points": {
                                  "type": "integer"
                                }
                              },
                              "required": [
                                "position",
                                "team_number",
                                "name",
                                "points"
                              ],
                              "additionalProperties": false
                            },
                            "minItems": 1,
                            "maxItems": 10
                          }
                        },
                        "required": [
                          "rows"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "component",
                      "content"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "component": {
                        "type": "string",
                        "const": "Prose"
                      },
                      "content": {
                        "type": "object",
                        "properties": {
                          "markdown": {
                            "type": "string",
                            "maxLength": 12000,
                            "pattern": "\\S"
                          }
                        },
                        "required": [
                          "markdown"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "component",
                      "content"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "component": {
                        "type": "string",
                        "const": "Quote"
                      },
                      "content": {
                        "type": "object",
                        "properties": {
                          "text": {
                            "type": "string",
                            "maxLength": 2000,
                            "pattern": "\\S"
                          },
                          "attribution": {
                            "type": "string",
                            "maxLength": 200,
                            "pattern": "\\S"
                          }
                        },
                        "required": [
                          "text",
                          "attribution"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "component",
                      "content"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "component": {
                        "type": "string",
                        "const": "Figure"
                      },
                      "content": {
                        "type": "object",
                        "properties": {
                          "image_id": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "alt": {
                            "type": "string",
                            "maxLength": 1000,
                            "pattern": "\\S"
                          },
                          "caption": {
                            "type": "string",
                            "maxLength": 1000,
                            "pattern": "\\S"
                          },
                          "link": {
                            "type": "string",
                            "maxLength": 2000
                          }
                        },
                        "required": [
                          "image_id",
                          "alt"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "component",
                      "content"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "component": {
                        "type": "string",
                        "const": "Photos"
                      },
                      "content": {
                        "type": "object",
                        "properties": {
                          "photos": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "image_id": {
                                  "type": "string",
                                  "format": "uuid"
                                },
                                "alt": {
                                  "type": "string",
                                  "maxLength": 1000,
                                  "pattern": "\\S"
                                },
                                "caption": {
                                  "type": "string",
                                  "maxLength": 1000,
                                  "pattern": "\\S"
                                }
                              },
                              "required": [
                                "image_id",
                                "alt"
                              ],
                              "additionalProperties": false
                            },
                            "minItems": 2,
                            "maxItems": 20
                          },
                          "caption": {
                            "type": "string",
                            "maxLength": 1000,
                            "pattern": "\\S"
                          }
                        },
                        "required": [
                          "photos"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "component",
                      "content"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "component": {
                        "type": "string",
                        "const": "Video"
                      },
                      "content": {
                        "anyOf": [
                          {
                            "type": "object",
                            "properties": {
                              "provider": {
                                "type": "string",
                                "const": "youtube"
                              },
                              "video_id": {
                                "type": "string",
                                "pattern": "^[A-Za-z0-9_-]{11}$"
                              },
                              "title": {
                                "type": "string",
                                "maxLength": 200,
                                "pattern": "\\S"
                              },
                              "duration": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 86400
                              }
                            },
                            "required": [
                              "provider",
                              "video_id",
                              "title"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "provider": {
                                "type": "string",
                                "const": "hosted"
                              },
                              "video_id": {
                                "type": "string",
                                "format": "uuid"
                              },
                              "title": {
                                "type": "string",
                                "maxLength": 200,
                                "pattern": "\\S"
                              },
                              "duration": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 86400
                              }
                            },
                            "required": [
                              "provider",
                              "video_id",
                              "title"
                            ],
                            "additionalProperties": false
                          }
                        ]
                      }
                    },
                    "required": [
                      "component",
                      "content"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "component": {
                        "type": "string",
                        "const": "Map"
                      },
                      "content": {
                        "type": "object",
                        "properties": {
                          "caption": {
                            "type": "string",
                            "maxLength": 200,
                            "pattern": "\\S"
                          },
                          "places": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "name": {
                                  "type": "string",
                                  "maxLength": 120,
                                  "pattern": "\\S"
                                },
                                "region": {
                                  "anyOf": [
                                    {
                                      "type": "string",
                                      "maxLength": 120,
                                      "pattern": "\\S"
                                    },
                                    {
                                      "type": "null"
                                    }
                                  ]
                                },
                                "country": {
                                  "type": "string",
                                  "maxLength": 120,
                                  "pattern": "\\S"
                                },
                                "latitude": {
                                  "type": "number",
                                  "minimum": -90,
                                  "maximum": 90
                                },
                                "longitude": {
                                  "type": "number",
                                  "minimum": -180,
                                  "maximum": 180
                                },
                                "years": {
                                  "type": "array",
                                  "items": {
                                    "type": "integer",
                                    "minimum": 2016,
                                    "maximum": 2100
                                  },
                                  "maxItems": 100
                                }
                              },
                              "required": [
                                "name",
                                "region",
                                "country",
                                "latitude",
                                "longitude",
                                "years"
                              ],
                              "additionalProperties": false
                            },
                            "minItems": 1,
                            "maxItems": 1000
                          },
                          "routes": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "year": {
                                  "type": "integer",
                                  "minimum": 2016,
                                  "maximum": 2100
                                },
                                "days": {
                                  "type": "array",
                                  "items": {
                                    "type": "object",
                                    "properties": {
                                      "day": {
                                        "type": "integer",
                                        "minimum": 1,
                                        "maximum": 10
                                      },
                                      "camp": {
                                        "type": "object",
                                        "properties": {
                                          "name": {
                                            "anyOf": [
                                              {
                                                "type": "string",
                                                "maxLength": 60,
                                                "pattern": "\\S"
                                              },
                                              {
                                                "type": "null"
                                              }
                                            ]
                                          },
                                          "latitude": {
                                            "type": "number",
                                            "minimum": -90,
                                            "maximum": 90
                                          },
                                          "longitude": {
                                            "type": "number",
                                            "minimum": -180,
                                            "maximum": 180
                                          }
                                        },
                                        "required": [
                                          "name",
                                          "latitude",
                                          "longitude"
                                        ],
                                        "additionalProperties": false
                                      },
                                      "greens": {
                                        "type": "array",
                                        "items": {
                                          "type": "object",
                                          "properties": {
                                            "latitude": {
                                              "type": "number",
                                              "minimum": -90,
                                              "maximum": 90
                                            },
                                            "longitude": {
                                              "type": "number",
                                              "minimum": -180,
                                              "maximum": 180
                                            }
                                          },
                                          "required": [
                                            "latitude",
                                            "longitude"
                                          ],
                                          "additionalProperties": false
                                        },
                                        "maxItems": 40
                                      }
                                    },
                                    "required": [
                                      "day",
                                      "camp",
                                      "greens"
                                    ],
                                    "additionalProperties": false
                                  },
                                  "minItems": 1,
                                  "maxItems": 10
                                }
                              },
                              "required": [
                                "year",
                                "days"
                              ],
                              "additionalProperties": false
                            },
                            "maxItems": 20
                          }
                        },
                        "required": [
                          "places"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "component",
                      "content"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "minItems": 1,
              "maxItems": 12
            }
          },
          "required": [
            "headline",
            "summary",
            "as_of",
            "telling"
          ],
          "additionalProperties": false
        },
        "standing": {
          "type": "object",
          "properties": {
            "draft": {
              "type": "boolean"
            },
            "exploration": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 200,
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            },
            "slot": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*:[a-z0-9]+(-[a-z0-9]+)*$"
                    },
                    "label": {
                      "type": "string",
                      "maxLength": 200,
                      "pattern": "\\S"
                    }
                  },
                  "required": [
                    "key",
                    "label"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "draft",
            "exploration",
            "slot"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "story",
        "standing"
      ],
      "additionalProperties": false
    }
  }
}
