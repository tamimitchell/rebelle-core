{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "src/prose.ts",
    "src/story.ts",
    "src/ui/story.tsx",
    "src/dispatch.ts",
    "src/ui/dispatch.tsx",
    "src/ui/post.tsx",
    "src/positions.ts"
  ]
}
