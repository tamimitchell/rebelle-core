{
  "name": "@rebelle/core",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schemas": "./src/schemas.ts",
    "./story": "./src/story.ts",
    "./story-a2ui": "./src/story-a2ui.ts",
    "./tokens.css": "./dist/tokens.css",
    "./system.css": "./dist/system.css",
    "./register.json": "./dist/register.json",
    "./stylesheet": "./src/stylesheet.ts",
    "./team-results": "./src/team-results.ts",
    "./team-results-a2ui": "./src/team-results-a2ui.ts",
    "./ui/team-results": "./src/ui/team-results.tsx",
    "./ui/team-results.css": "./src/ui/team-results.css",
    "./ui/team-results-surface": "./src/ui/team-results-surface.tsx",
    "./ui/story": "./src/ui/story.tsx",
    "./ui/story.css": "./src/ui/story.css",
    "./ui/hosted-video": "./src/ui/hosted-video.tsx",
    "./ui/hosted-video.css": "./src/ui/hosted-video.css",
    "./ui/story-surface": "./src/ui/story-surface.tsx",
    "./team-results-catalog.json": "./dist/team-results-catalog.json",
    "./prose": "./src/prose.ts",
    "./story-catalog.json": "./dist/story-catalog.json",
    "./voice.md": "./voice.md",
    "./principles.md": "./principles.md",
    "./ui/post": "./src/ui/post.tsx",
    "./dispatch": "./src/dispatch.ts",
    "./ui/dispatch": "./src/ui/dispatch.tsx",
    "./ui/dispatch.css": "./src/ui/dispatch.css",
    "./positions": "./src/positions.ts",
    "./black-diamond": "./src/black-diamond.ts"
  },
  "scripts": {
    "build:tokens": "node scripts/build-tokens.mjs && node --experimental-strip-types scripts/build-register.ts",
    "build:register": "node --experimental-strip-types scripts/build-register.ts",
    "test": "node --experimental-strip-types --test test/*.test.ts && node --import tsx --test test/*.test.tsx",
    "build:catalog": "node --experimental-strip-types scripts/build-catalog.ts && node scripts/build-prose-validator.mjs",
    "check": "tsc"
  },
  "dependencies": {
    "markdown-it": "15.0.2",
    "zod": "^3.24.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "esbuild": "0.25.10",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "4.20.5",
    "typescript": "7.0.2",
    "zod-to-json-schema": "3.25.2"
  }
}
